generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  description  String
  price        Decimal   @db.Decimal(10, 2)
  images       String
  category     String
  subCategory  String
  sizes        String
  bestseller   Boolean   @default(false)
  date         BigInt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  // cartData  String
}
